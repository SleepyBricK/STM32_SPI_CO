{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake"
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Debug-HW",
      "inherits": "Debug",
      "cacheVariables": {
        "WITH_INTAN_HW": "ON",
        "INTAN_CS_HW_NSS": "ON",
        "BOARD_SYSCLK_480": "ON"
      }
    },
    {
      "name": "Release-HW",
      "inherits": "Release",
      "cacheVariables": {
        "WITH_INTAN_HW": "ON",
        "INTAN_CS_HW_NSS": "ON",
        "BOARD_SYSCLK_480": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Debug-HW",
      "configurePreset": "Debug-HW"
    },
    {
      "name": "Release-HW",
      "configurePreset": "Release-HW"
    }
  ]
}
